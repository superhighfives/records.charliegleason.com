node_modules
.DS_Store
dist
dist-ssr
*.local
.env
.nitro
.tanstack
.wrangler
.output
.vinxi
__unconfig*
todos.json
mcp-todos.json
# Cached fonts for scripts/generate-og.mjs (re-downloaded on demand)
scripts/.fonts/

# Cog build artifacts
cog/**/.cog/

# Generated by scripts/backfill-master-metadata.mjs (regenerate; do not commit)
scripts/backfill-master-metadata.sql

# Rust build output for crates/*. `pkg/` (the built wasm + JS glue, crates/*/pkg) IS
# committed — it's what the app actually imports, tiny (~60KB), and regenerating it
# needs the Rust toolchain + wasm-pack, which CI/most dev machines won't have.
crates/*/target/

# rec/ — the ESP32-S3 board firmware (see rec/CLAUDE.md)
rec/firmware/.cache/
rec/firmware/build/
rec/firmware/build-perf/
rec/firmware/managed_components/
rec/firmware/sdkconfig
rec/backups/
rec/reports/
rec/__pycache__/
rec/**/*.py[cod]
rec/.ruff_cache/

# mac/ — the Records.app companion (see mac/README.md). The .xcodeproj is
# generated by `xcodegen generate` from project.yml — regenerate, don't commit.
mac/Records.xcodeproj/
mac/**/xcuserdata/
mac/*.xcuserstate
