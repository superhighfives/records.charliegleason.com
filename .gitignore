# Cached fonts for scripts/generate-og.mjs (re-downloaded on demand)
scripts/.fonts/

# Cog build artifacts
cog/**/.cog/

# Generated by scripts/backfill-master-metadata.mjs (regenerate; do not commit)
scripts/backfill-master-metadata.sql

# Rust build output for crates/*. `pkg/` (the built wasm + JS glue, crates/*/pkg) IS
# committed — it's what the app actually imports, tiny (~60KB), and regenerating it
# needs the Rust toolchain + wasm-pack, which CI/most dev machines won't have.
crates/*/target/
