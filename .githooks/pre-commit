#!/bin/sh
# Auto-format and lint-fix staged files with Biome before every commit, so a
# stray formatting difference never makes it to CI (`bun run check`) and fails
# there. Only staged files are touched (`--staged`); safe fixes are applied in
# place (`--write`) and re-staged. If Biome still reports an error it can't fix
# (e.g. a real lint violation), the commit is blocked with the diagnostics.
#
# Activated by the `prepare` script in package.json, which points
# core.hooksPath at this directory on `bun install`.

bunx biome check --write --staged --no-errors-on-unmatched --files-ignore-unknown=true
status=$?

# Re-stage any fixes Biome just wrote to already-staged files.
git update-index --again

if [ $status -ne 0 ]; then
	exit $status
fi

# src/routeTree.gen.ts is committed but derived from src/routes/** — the dev
# server's watcher keeps it in sync while it's running, but a route file edited
# without it (or a stale copy from before a rebase) would otherwise commit out
# of sync, surfacing as confusing type errors at createFileRoute() call sites
# rather than here (and CI's own check would then block the push). Regenerate
# and re-stage it here too, same treatment as the Biome fixes above.
bun run generate-routes >/dev/null || exit 1
git add src/routeTree.gen.ts

exit 0
