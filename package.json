{
  "name": "records",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "dotenv -e .env.local -- vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "deploy": "bun run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply records --remote",
    "db:migrate:local": "wrangler d1 migrations apply records --local",
    "db:migrate:preview": "wrangler d1 migrations apply records-preview --remote --env preview"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.3.6",
