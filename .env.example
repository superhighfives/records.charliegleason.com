# Copy to .env.local for development. In production set secrets with:
#   bunx wrangler secret put <NAME>
# Bindings (DB, PHOTOS, AI, EMAIL) are configured in wrangler.jsonc, not here.

# --- Clerk (auth) ---
# Frontend (public). Server-side auth() needs the secret key.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Sentry (error monitoring) ---
VITE_SENTRY_DSN=
# Build-time source map upload (optional)
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Cloudflare D1 (Drizzle Kit: db:push / db:studio against remote) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# --- AI ---
# Claude (Sonnet 4.6) via Cloudflare Workers AI partner models + Unified Billing —
# NO Anthropic key; Cloudflare bills it to your account (Workers Paid + credits).
# AI_GATEWAY_NAME is the AI Gateway to route through; blank → "default" (auto-created).
AI_GATEWAY_NAME=
# Only if runClaude() is switched to the AI Gateway native passthrough (guaranteed
# server-side web_search): a Cloudflare AI Gateway auth token. Unused by env.AI.run.
# CF_AIG_TOKEN=

# --- Enrichment APIs ---
# Discogs personal access token (discogs.com/settings/developers) — used as
# `Authorization: Discogs token=...` for release lookup.
DISCOGS_TOKEN=
LASTFM_API_KEY=
