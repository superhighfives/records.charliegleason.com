# Copy to .env.local for development. In production set secrets with:
#   bunx wrangler secret put <NAME>
# Bindings (DB, PHOTOS, AI, EMAIL) are configured in wrangler.jsonc, not here.

# --- Clerk (auth) ---
# Frontend (public). Server-side auth() needs the secret key.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Sentry (error monitoring) ---
VITE_SENTRY_DSN=
# Build-time source map upload (optional)
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- AI ---
# Claude (Sonnet 4.6) via Cloudflare Workers AI partner models + Unified Billing —
# NO Anthropic key; Cloudflare bills it to your account (Workers Paid + credits).
# AI_GATEWAY_NAME is the AI Gateway to route through; blank → "default" (auto-created).
AI_GATEWAY_NAME=
# Only if runClaude() is switched to the AI Gateway native passthrough (guaranteed
# server-side web_search): account id + a gateway auth token. Unused by env.AI.run.
# CLOUDFLARE_ACCOUNT_ID=
# CF_AIG_TOKEN=

# --- Enrichment APIs ---
# Discogs personal access token (discogs.com/settings/developers) — used as
# `Authorization: Discogs token=...` for release lookup.
DISCOGS_TOKEN=

# --- Daily digest (Last.fm → Cloudflare Email cron) ---
LASTFM_API_KEY=
LASTFM_USER=
# Shared secret for the manual POST /api/cron/digest trigger (x-cron-secret).
CRON_SECRET=

# --- CI deploy (GitHub Actions) ---
# Production deploys run in CI (.github/workflows/deploy.yml), NOT locally — a local
# `bun run deploy` would inline this file's (test) Clerk key into the bundle. These two
# authenticate `wrangler deploy` and live as GitHub repo secrets, not in local dev.
# The build-time VITE_*/SENTRY_* vars above double as the CI build secrets (set them in
# GitHub with the pk_live_… / production values). See SETUP.md §6.
# CLOUDFLARE_API_TOKEN=   # "Edit Cloudflare Workers" template + charliegleason.com zone
# CLOUDFLARE_ACCOUNT_ID=  # from `wrangler whoami` (also reused by the AI-gateway note above)
