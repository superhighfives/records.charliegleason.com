# Copy to .env.local for development. In production set secrets with:
#   bunx wrangler secret put <NAME>
# Bindings (DB, PHOTOS, AI, EMAIL) are configured in wrangler.jsonc, not here.

# --- Clerk (auth) ---
# Frontend (public). Server-side auth() needs the secret key.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Sentry (error monitoring) ---
VITE_SENTRY_DSN=
# Build-time source map upload (optional)
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Cloudflare D1 (Drizzle Kit: db:push / db:studio against remote) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# --- AI ---
# Used by TanStack AI adapters. For Cloudflare Workers AI / AI Gateway, point the
# openaiCompatible adapter at your AI Gateway endpoint instead.
ANTHROPIC_API_KEY=

# --- Enrichment APIs ---
DISCOGS_TOKEN=
LASTFM_API_KEY=
