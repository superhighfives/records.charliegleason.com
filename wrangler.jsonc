{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "records",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "@tanstack/react-start/server-entry",
	// Custom domain. Attach records.charliegleason.com as a Workers Custom Domain
	// (Cloudflare dashboard) or uncomment + set the zone below.
	// "routes": [
	//   { "pattern": "records.charliegleason.com", "custom_domain": true }
	// ],
	// D1 — primary database (Drizzle). `remote: true` makes `wrangler dev` use the
	// real D1 instead of a local SQLite file.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "records",
			"database_id": "70aaf237-a260-4b82-ad2d-427912cb7863",
			"migrations_dir": "drizzle",
			"remote": true
		}
	],
	// R2 — vinyl cover photos.
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "records-photos",
			"remote": true
		}
	],
	// Workers AI — photo analysis / metadata extraction. Also usable via AI Gateway.
	"ai": {
		"binding": "AI"
	},
	// Daily "records to buy" digest email (Cron Trigger drives the job).
	"triggers": {
		"crons": [
			"0 14 * * *"
		]
	},
	// Cloudflare Email Routing send binding (set the verified sender address).
	"send_email": [
		{
			"name": "EMAIL",
			"destination_address": "hi@charliegleason.com"
		}
	]
}