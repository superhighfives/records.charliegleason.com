{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "records",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/server.ts",
	// Workers Logs — capture invocation logs + outcomes (incl. uncatchable kills
	// like exceededMemory / exceededCpu that never reach Sentry). Without this a
	// queue consumer OOM'd mid-generation was completely invisible; with it, the
	// next occurrence's `outcome` tells us the exact cause. head_sampling_rate:1
	// keeps everything — volume here is tiny (a personal collection).
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	// Custom domain — provisions DNS + SSL for the records subdomain on deploy
	// (apex MX/Gmail untouched). Requires charliegleason.com to be a Cloudflare zone.
	"routes": [
		{ "pattern": "records.charliegleason.com", "custom_domain": true }
	],
	// Lets the worker tell production apart from the preview deploy at runtime —
	// used to gate Sentry reporting (src/server.ts). Overridden in env.preview.
	"vars": {
		"ENVIRONMENT": "production"
	},
	// D1 — primary database (Drizzle). `remote: true` makes `wrangler dev` use the
	// real D1 instead of a local SQLite file.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "records",
			"database_id": "70aaf237-a260-4b82-ad2d-427912cb7863",
			"migrations_dir": "drizzle",
			"remote": true
		}
	],
	// R2 — vinyl cover photos.
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "records-photos",
			"remote": true
		}
	],
	// Workers AI — photo analysis / metadata extraction. Also usable via AI Gateway.
	"ai": {
		"binding": "AI"
	},
	// Queues — background jobs, dispatched by message.body.mode in the shared consumer
	// (src/server.ts → handleAnalyzeBatch). Two queues, one consumer worker:
	// `records-capture` carries ONLY new-capture analysis (enqueueAnalyze), so a bulk
	// Apply/enhance batch churning on `records-analyze` can never starve a fresh upload
	// out of its analysis — the exact starvation seen when a wedged 16-job enhance batch
	// held both `records-analyze` consumer slots for half an hour. Everything else
	// (professional/matte stages, rescans, refreshes, colors, ASIN, audits) stays on
	// `records-analyze`. One message per record/color, retried up to 3× before the
	// shared dead-letter queue. Provision once: `wrangler queues create records-analyze`,
	// `wrangler queues create records-capture` and `wrangler queues create records-analyze-dlq`.
	"queues": {
		"producers": [
			{
				"binding": "ANALYZE_QUEUE",
				"queue": "records-analyze"
			},
			{
				"binding": "CAPTURE_QUEUE",
				"queue": "records-capture"
			}
		],
		"consumers": [
			{
				"queue": "records-analyze",
				"max_batch_size": 1,
				"max_batch_timeout": 5,
				"max_retries": 3,
				// Throttle: cap simultaneous consumer invocations so a bulk "Rescan
				// all" (or a big capture session) drains steadily instead of fanning
				// out into a burst of parallel AI Gateway / Discogs calls that trips
				// rate limits and AI-credit caps all at once.
				"max_concurrency": 2,
				"dead_letter_queue": "records-analyze-dlq"
			},
			{
				"queue": "records-capture",
				"max_batch_size": 1,
				"max_batch_timeout": 5,
				"max_retries": 3,
				// A capture session is a human photographing sleeves one at a time —
				// 2 concurrent analyses keeps pace with that without adding to the
				// AI-rate-limit pressure the records-analyze throttle exists for.
				"max_concurrency": 2,
				"dead_letter_queue": "records-analyze-dlq"
			}
		]
	},
	// Cloudflare Images — resize sourced cover art before storing in R2. Requires
	// Image Transformations enabled on the account (dashboard → Images).
	"images": {
		"binding": "IMAGES"
	},
	// Matte render container — the Apply pipeline's sleeve matte renders here (real RAM),
	// off the 128 MB queue-consumer isolate that OOM-looped on it. Built from
	// containers/matte/Dockerfile with the REPO ROOT as build context
	// (`image_build_context: "."`) so the bundle step can reach the shared src/lib pure
	// modules. Fronted by the MatteContainer DO. Production only — preview can't host the
	// DO (its `versions upload` deploy can't apply DO migrations), so it falls back to the
	// in-Worker matte render (see renderAiMatte / renderDeterministicMatte).
	"containers": [
		{
			"class_name": "MatteContainer",
			"image": "./containers/matte/Dockerfile",
			"image_build_context": ".",
			"instance_type": "standard-1",
			"max_instances": 3,
			// Give active instances time to drain in-flight /enhance and /matte requests
			// before a rollout (platform- or deploy-triggered) shuts them down. Default is
			// 0 — a hard mid-request kill — which is what mass-failed a batch of Apply jobs
			// when the platform rolled the container to a new version: every in-flight
			// enhance died uncatchably (no catch, no Sentry) and the reaper burned its
			// retries against the flapping instances. A run holds the DO across Replicate
			// polling (up to two ~120s models + the webp encode), so 300s covers the worst
			// case and lets a roll drain instead of hard-kill.
			"rollout_active_grace_period": 300
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "MATTE_CONTAINER", "class_name": "MatteContainer" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["MatteContainer"] }
	],
	// Cron Triggers — dispatched by expression in src/server.ts `scheduled`:
	//   "0 14 * * 1" — weekly "records to buy" digest email, Mondays 14:00 UTC.
	//   "0 9 * * *"  — daily master-link health check (flags deleted/merged Discogs
	//                  masters, 50 rows/run stalest-first), 09:00 UTC.
	//   "0 13 * * *" — daily "record of the day" email (a random notes-empty record,
	//                  reply-to-add-notes via Email Routing), 13:00 UTC.
	"triggers": {
		"crons": [
			"0 14 * * 1",
			"0 9 * * *",
			"0 13 * * *"
		]
	},
	// Cloudflare Email Sending (Email Service, beta) — onboard charliegleason.com
	// for sending (dashboard → Compute → Email Service → Email Sending). It adds a
	// cf-bounce subdomain MX + SPF/DKIM/DMARC TXT records; the apex MX (Gmail) is
	// untouched. Sends to any recipient; no destination_address restriction.
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true
		}
	]
	// No `env.preview` block: PR previews are ephemeral per-PR Workers
	// (`records-pr-<n>`), deployed by .github/workflows/preview.yml, which rewrites
	// THIS top-level config at CI time (unique name, per-PR queue, prod D1/R2,
	// container/DO/cron/email stripped). See that workflow's header for the model
	// and the required repo secrets.
}